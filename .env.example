# Copy this file to .env and fill in your own values.

# --- Ollama providers (multiple API keys supported) ---------------------------
# Leave blank for local Ollama; set a real key for Ollama Cloud.
OLLAMA_API_KEY=

# Additional keys — each becomes its own provider (auto-discovered):
# OLLAMA_API_KEY_WORK=another_key
# OLLAMA_API_KEY_PERSONAL=another_key

# Optional overrides:
# OLLAMA_HOST=https://ollama.com          # host for OLLAMA_API_KEY
# OLLAMA_LOCAL_HOST=http://localhost:11434

# Default chat model (override at runtime with /model <name>)
OLLAMA_MODEL=qwen3:8b

# Embedding model for semantic memory search
EMBED_MODEL=nomic-embed-text

# Context window Kara requests from the model, in tokens.
# Ollama defaults to 4096 and silently truncates anything past it. Kara's system
# prompt plus its always-on tool schemas already cost ~4,000 tokens, so leaving
# this at Ollama's default would drop the head of the prompt without any error.
# Set this to what your model actually supports.
KARA_MODEL_CONTEXT_TOKENS=32768

# --- Turn limits --------------------------------------------------------------
# Bounds on a single message. Without these the tool loop can run forever.
# KARA_MAX_TOOL_ITERATIONS=25         # tool steps before Kara stops and reports back
# KARA_TURN_TIMEOUT_SECONDS=600       # wall-clock budget for one turn
# KARA_MAX_REPEATED_TOOL_CALLS=3      # identical consecutive calls treated as stuck

# --- Context compaction -------------------------------------------------------
# Older conversation is trimmed and summarized once it would use this share of
# the window, so a long-running chat does not eventually stop working.
# KARA_COMPACT_AT_FRACTION=0.75
# KARA_MAX_TOOL_RESULT_CHARS=8000     # cap on an old tool result kept in history

# --- Telegram bot -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- Web search (SearXNG) + fetch ---------------------------------------------
SEARXNG_URL=https://search.ameera.dev
# Cloudflare Access service token (Zero Trust -> Access -> Service Auth)
CF_ACCESS_CLIENT_ID=your_cloudflare_access_client_id
CF_ACCESS_CLIENT_SECRET=your_cloudflare_access_client_secret
# Or paste a browser session cookie if you use SSO instead of service tokens:
# CF_ACCESS_COOKIE=

# --- Email (Himalaya CLI) -----------------------------------------------------
# Install: https://github.com/pimalaya/himalaya/releases
# Windows without Scoop: extract himalaya.x86_64-windows.zip to personal_agent/bin/
# HIMALAYA_BIN="D:/GitHub Repos/Kara-local/personal_agent/bin/himalaya.exe"
# HIMALAYA_CONFIG=C:/Users/you/.config/himalaya/config.toml
# HIMALAYA_ACCOUNT=personal
# Safety gate — Kara can read/search mail by default; set true to allow sending:
# EMAIL_SEND_ENABLED=false

# --- GitHub (OAuth device flow, not a fine-grained token) ---------------------
# 1. github.com -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
# 2. Any homepage/callback URL works (unused by device flow); enable "Device Flow"
#    on the app's settings page after creating it.
# 3. Paste the app's Client ID below, then run: uv run python github_auth.py login
GITHUB_CLIENT_ID=
# Optional: space-separated OAuth scopes (default covers repo, actions, gists, orgs, notifications)
# GITHUB_OAUTH_SCOPES=repo workflow gist read:org notifications
# GITHUB_GIT_TIMEOUT=120

# --- Optional Mnemosyne memory MCP server --------------------------------------
# Separate SQLite-backed memory system reached over MCP; does not replace
# Kara's own core/learnings/session memory. Install as a project dependency
# (not a bare pip install elsewhere) from personal_agent/:
#   uv add "mnemosyne-memory[mcp,embeddings]"
# Only set MNEMOSYNE_BIN if the executable lives outside this venv — Kara
# already finds it there automatically (see README > Mnemosyne).
# MNEMOSYNE_BIN=
# MNEMOSYNE_DB_PATH=

# --- Optional external Obsidian vault -----------------------------------------
OBSIDIAN_VAULT_PATH=

# --- Local file safety --------------------------------------------------------
# Path-list separated roots (semicolon on Windows, colon on Linux/macOS).
# Reads default to project + user home;
# writes default to the project only. Expand writes deliberately, for example:
# KARA_FILE_READ_ROOTS="D:/GitHub Repos/Kara-local/personal_agent;C:/Users/you"
# KARA_FILE_WRITE_ROOTS="D:/GitHub Repos/Kara-local/personal_agent;C:/Users/you/Documents"
# Linux/macOS example:
# KARA_FILE_READ_ROOTS="/home/you/Kara-Personal-Agent:/home/you/Documents"
# KARA_FILE_WRITE_ROOTS="/home/you/Kara-Personal-Agent:/home/you/Documents"
# KARA_ALLOW_SENSITIVE_FILES=0
# KARA_FILE_SEARCH_TIMEOUT=12
# KARA_DOCUMENT_MAX_BYTES=52428800
# KARA_DOCUMENT_MAX_CHARS=50000
# KARA_PDF_MAX_PAGES=50
# KARA_OCR_MAX_IMAGE_PIXELS=40000000
# KARA_OCR_TIMEOUT_SECONDS=30
# KARA_PDF_TIMEOUT_SECONDS=60
# KARA_PDF_WORKER_MEMORY_MB=512

# --- Optional desktop control (Windows, Linux, macOS) -------------------------
# Install Cua Driver separately: https://cua.ai/docs/how-to-guides/driver/install
# KARA_CUA_ENABLED=1
# KARA_CUA_DRIVER_CMD=cua-driver
# KARA_CUA_TELEMETRY=0
# KARA_CUA_FOCUS_SETTLE_SECONDS=0.2

# --- Durable reminders and autonomous jobs -----------------------------------
# KARA_TIMEZONE=Europe/Dublin
# KARA_SCHEDULER_POLL_SECONDS=15
